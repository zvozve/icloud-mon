<!DOCTYPE RCC>
<RCC version="1.0">
    <qresource prefix="/">
        <!-- QML 文件统一放 /qml/ 下, 引擎用 qrc:/qml/Main.qml 加载 -->
        <file alias="qml/qmldir">qmldir</file>
        <file alias="qml/Main.qml">../ui/Main.qml</file>
        <file alias="qml/Theme.qml">../ui/Theme.qml</file>
        <!-- 导航 -->
        <file alias="qml/NavIcon.qml">../ui/NavIcon.qml</file>
        <file alias="qml/NavItem.qml">../ui/NavItem.qml</file>
        <!-- 页面: 首页 / 云盘 / 相册 / 密码 / 书签 / 设置 -->
        <file alias="qml/HomePage.qml">../ui/HomePage.qml</file>
        <file alias="qml/DrivePage.qml">../ui/DrivePage.qml</file>
        <file alias="qml/CategoryPage.qml">../ui/CategoryPage.qml</file>
        <file alias="qml/SettingsPage.qml">../ui/SettingsPage.qml</file>
        <!-- 复用组件 -->
        <file alias="qml/StatusCard.qml">../ui/StatusCard.qml</file>
        <file alias="qml/QueuePanel.qml">../ui/QueuePanel.qml</file>
        <file alias="qml/PcsPanel.qml">../ui/PcsPanel.qml</file>
        <file alias="qml/AlertBanner.qml">../ui/AlertBanner.qml</file>
    </qresource>
</RCC>
